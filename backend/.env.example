# Server Configuration
HOST=127.0.0.1
PORT=8000

# Default Local Code Directory (can point to any local folder on your disk)
LOCAL_CODE_DIR=./

# Graphify AST Settings
DEFAULT_DETAIL_LEVEL=components
DEFAULT_MAX_NODES=50
DEFAULT_DIRECTION=TD
DEFAULT_GROUP_BY=community

# Timeouts in seconds
GIT_CLONE_TIMEOUT=90
AST_EXTRACT_TIMEOUT=120
